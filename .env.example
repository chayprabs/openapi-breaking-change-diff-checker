# Copy to `.env.local` and set only what you need.

# Public site origin for canonical URLs, Open Graph, sitemap, and robots.
# On Vercel you can omit this and rely on VERCEL_URL instead.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.example.com

# Metadata-only analytics (disabled when unset).
# Supported: disabled, console, custom, plausible, posthog
# NEXT_PUBLIC_ANALYTICS_PROVIDER=console

# Required when NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com

# Required when NEXT_PUBLIC_ANALYTICS_PROVIDER=posthog
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional feedback delivery
# NEXT_PUBLIC_FEEDBACK_ENDPOINT=/api/feedback
# NEXT_PUBLIC_FEEDBACK_EMAIL=feedback@example.com
# FEEDBACK_WEBHOOK_SECRET=
# FEEDBACK_WEBHOOK_URL=

# Safe public OpenAPI URL fetch proxy (server-only)
# OPENAPI_FETCH_PROXY_RATE_LIMIT=20
# OPENAPI_FETCH_PROXY_RATE_LIMIT_WINDOW_MS=60000

# Platform (accounts, saved reports, team rules)
# DATABASE_URL=postgresql://user:pass@localhost:5432/authos
# AUTH_SECRET=generate-with-openssl-rand-base64-32
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_URL=http://localhost:3000

# Object storage for private report blobs (optional)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Shared rate limiting (optional, production multi-instance)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cron / GitHub integrations
# CRON_SECRET=
# GITHUB_APP_WEBHOOK_SECRET=

# Vitest only: refresh golden snapshots
# UPDATE_GOLDENS=1
